<script>
  const ua = navigator.userAgent || navigator.vendor || window.opera;
  const isAndroid = /android/i.test(ua);
  const isIOS = /iPad|iPhone|iPod/.test(ua) && !window.MSStream;

  const androidBadge = document.getElementById('android-badge');
  const iosBadge = document.getElementById('ios-badge');
  const badgeContainer = document.getElementById('store-badges');
  const platformText = document.getElementById('platform-text');
  const iosNote = document.getElementById('ios-note');

  // Logout endpoint that can handle redirection after
  const logoutURL = "/index.php?role=public&pg=logout";

  // Set platform display
  if (isAndroid) {
    androidBadge.style.display = 'inline-block';
    badgeContainer.style.display = 'flex';
    platformText.textContent = 'através da app para Android';
  } else if (isIOS) {
    iosBadge.style.display = 'inline-block';
    badgeContainer.style.display = 'flex';
    platformText.textContent = 'através da app para iOS';
    iosNote.style.display = 'block';
  } else {
    androidBadge.style.display = 'inline-block';
    iosBadge.style.display = 'inline-block';
    badgeContainer.style.display = 'flex';
    platformText.textContent = 'através da app para Android ou iOS';
  }

  let userClicked = false;

  androidBadge.addEventListener('click', function (e) {
    e.preventDefault();
    userClicked = true;
    location.replace(`${logoutURL}&id=request&param=android`);
  });

  iosBadge.addEventListener('click', function (e) {
    e.preventDefault();
    userClicked = true;
    location.replace(`${logoutURL}&id=request&param=ios`);
  });

  // Timeout logout after 5s if not clicked
  setTimeout(() => {
    if (!userClicked) {
      location.replace(logoutURL);
    }
  }, 5000);

  // Logout if user switches away
  const handleLeave = () => {
    if (!userClicked) {
      location.replace(logoutURL);
    }
  };

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) handleLeave();
  });

  window.addEventListener('beforeunload', handleLeave);
</script>