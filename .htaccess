Options +FollowSymLinks
RewriteEngine On
 
RewriteCond %{THE_REQUEST} /index\.php\?role=(admin|public)&pg=([a-z]+)&id=([0-9]+|new|request)&param=([0-9a-z@._\-]+) [NC]
RewriteRule ^ /%1/%2/%3/%4? [R=302,L,NE]

RewriteCond %{THE_REQUEST} /index\.php\?role=(admin|public)&pg=([a-z]+)&id=([0-9]+|new|request) [NC]
RewriteRule ^ /%1/%2/%3? [R=302,L,NE]

RewriteCond %{THE_REQUEST} /index\.php\?pg=([a-z]+)&id=([0-9]+|new|request)&param=([0-9]+|[[0-9a-z@._\-]+) [NC]
RewriteRule ^ /%1/%2/%3? [R=302,L,NE]

RewriteCond %{THE_REQUEST} /index\.php\?role=(admin|public)&pg=([a-z]+) [NC]
RewriteRule ^ /%1/%2? [R=302,L,NE]

RewriteCond %{THE_REQUEST} /index\.php\?pg=([a-z]+)&id=([0-9]+|new|request) [NC]
RewriteRule ^ /%1/%2? [R=302,L,NE]

RewriteCond %{THE_REQUEST} /index\.php\?role=(admin|public) [NC]
RewriteRule ^ /%1? [R=302,L,NE]

RewriteCond %{THE_REQUEST} /index\.php\?pg=([a-z]+) [NC]
RewriteRule ^ /%1? [R=302,L,NE]

RewriteCond %{SCRIPT_FILENAME} !-d
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteRule ^(admin|public)/([a-z]+)/([0-9]+|new|request)/([0-9]+|[0-9a-z@._\-]+)*$ ./index.php?role=$1&pg=$2&id=$3&param=$4

RewriteCond %{SCRIPT_FILENAME} !-d
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteRule ^(admin|public)/([a-z]+)/([0-9]+|new|request)*$ ./index.php?role=$1&pg=$2&id=$3

RewriteCond %{SCRIPT_FILENAME} !-d
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteRule ^([a-z]+)/([0-9]+|new|request)/([0-9]+|[0-9a-z@._\-]+)*$ ./index.php?pg=$1&id=$2&param=$3

RewriteCond %{SCRIPT_FILENAME} !-d
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteRule ^(admin|public)/([a-z]+)*$ ./index.php?role=$1&pg=$2

RewriteCond %{SCRIPT_FILENAME} !-d
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteRule ^([a-z]+)/([0-9]+|new|request)*$ ./index.php?pg=$1&id=$2

RewriteCond %{SCRIPT_FILENAME} !-d
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteRule ^(admin|public)*$ ./index.php?role=$1

RewriteCond %{SCRIPT_FILENAME} !-d
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteRule ^([a-z]+)*$ ./index.php?pg=$1
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^geotarget\.pt$ [OR]
RewriteCond %{HTTP_HOST} ^www\.geotarget\.pt$
RewriteRule ^/?$ "https\:\/\/geotarget\.pt\/" [R=301,L]

